# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Free AI keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: Gemini models to try in order when one runs out of free quota
# AI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# Any long random strings
APP_SECRET=
CRON_SECRET=

# Where the app runs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google OAuth client for Gmail sending and Meet booking (steps on the Settings page)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
